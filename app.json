{
  "expo": {
    "name": "YALAMATRIX SIS",
    "slug": "ysis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": false },
    "android": {
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-camera"
    ]
  }
}
