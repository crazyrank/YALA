# Copy this to .env.development for local work.
# NEVER create a real .env.production file on your laptop —
# production values live only on Render's environment variable dashboard.

NODE_ENV=development
PORT=4000

# Get this from your Neon project dashboard (Connection string, pooled)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Generate two DIFFERENT random secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

# Comma-separated browser origins allowed to call the API with cookies.
# Leave empty for mobile-only (recommended). Example:
# CORS_ORIGIN=https://admin.yalamatrix.example
CORS_ORIGIN=

# Progressive lockout after failed logins
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=30

# Photo storage — free Cloudinary account at cloudinary.com.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
