# Copy this to .env.development for local work.
# NEVER create a real .env.production file on your laptop —
# production values live only on Render's environment variable dashboard.

NODE_ENV=development
PORT=40

# Get this from your Neon project dashboard (Connection string, pooled)
DATABASE_URL=postgresql://user=require
# Generate two DIFFERENT random secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=ng-random-string
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN
JWT_REFRESH_EXPIRES_IN=

BCRYPT_SALT_ROUNDS=

# Photo storage — free Cloudinary account at cloudinary.com. Photo upload
# routes fail with a clear error until these are set; everything else
# works fine without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
