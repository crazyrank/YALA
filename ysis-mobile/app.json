{
  "expo": {
    "name": "YALAMATRIX SIS",
    "slug": "ysis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/yala-matrix-schools-logo.jpg",
    "splash": {
      "image": "./assets/yala-matrix-schools-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0d1f33"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yalamatrix.ysis",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "YALAMATRIX SIS needs camera access to capture student passport photographs.",
        "NSFaceIDUsageDescription": "Unlock YALAMATRIX SIS with Face ID."
      }
    },
    "android": {
      "package": "com.yalamatrix.ysis",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/yala-matrix-schools-logo.jpg",
        "backgroundColor": "#0d1f33"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YALAMATRIX SIS to access your camera to take student passport photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id-here"
      }
    }
  }
}
