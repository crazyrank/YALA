{
  "expo": {
    "name": "YALAMATRIX SIS",
    "slug": "ysis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to capture student passport photos.",
        "NSFaceIDUsageDescription": "Face ID is used to unlock the app securely."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.crazyrank.ysismobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YALAMATRIX SIS to access your camera to capture student passport photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f6d3169c-7b31-4412-a54b-8685dcc811e4"
      }
    },
    "icon": "./assets/app-icon.png"
  }
}
