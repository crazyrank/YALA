{
  "expo": {
    "name": "YALAMATRIX SIS",
    "slug": "ysis-mobile",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to capture student passport photos.",
        "NSFaceIDUsageDescription": "Face ID is used to unlock the app securely."
      },
      "bundleIdentifier": "com.crazyrank.ysismobile"
    },
    "android": {
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.crazyrank.ysismobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YALAMATRIX SIS to access your camera to capture student passport photos."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/yala-matrix-schools-logo.jpg",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "a92ff0c2-8e23-4adc-a6d8-1d573f5fb531"
      }
    },
    "icon": "./assets/app-icon.png",
    "owner": "lonescripter"
  },
  "owner": "lonescripter"
}
